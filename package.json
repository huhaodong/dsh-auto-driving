{
  "name": "dsh-model-fallback",
  "version": "0.7.0",
  "description": "DeepSeek Harness plugin: when a request fails with a model error before any output, it falls through the configured provider groups' models (then the next selected provider) until one works; transient failures retry with backoff under a liveness watchdog, dead turns self-resume with a templated continue wake-up, and an optional full-auto mode auto-answers permission/confirm/plan approvals with an AUTO-MODE.md audit trail. Adds its own Settings tab.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huhaodong/dsh-auto-driving.git"
  },
  "homepage": "https://github.com/huhaodong/dsh-auto-driving#readme",
  "bugs": {
    "url": "https://github.com/huhaodong/dsh-auto-driving/issues"
  },
  "author": "huhaodong",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "model-fallback",
    "failover",
    "llm"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/smoke.mjs && node test/client.mjs && node test/e2e.mjs && node test/next-settings.mjs && node test/compat.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.0.1-0 || ^0.1.0-0 || ^0.1.1-0 || ^0.1.2-0 || ^0.1.3-0 || ^0.1.4-0 || ^0.1.5-0 || ^0.1.6-0 || ^0.1.7-0 || ^0.1.8-0 || ^0.1.9-0 || ^0.2.0-0 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0 || ^0.3.0-0 || ^0.3.1-0 || ^0.3.2-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.0.1-0 || ^0.1.0-0 || ^0.1.1-0 || ^0.1.2-0 || ^0.1.3-0 || ^0.1.4-0 || ^0.1.5-0 || ^0.1.6-0 || ^0.1.7-0 || ^0.1.8-0 || ^0.1.9-0 || ^0.2.0-0 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0 || ^0.3.0-0 || ^0.3.1-0 || ^0.3.2-0",
    "@deepseek-ai/schemastery": "^3.18.1-0 || ^3.18.2-0 || ^3.18.3-0 || ^3.18.4-0 || ^3.18.5-0 || ^3.18.6-0 || ^3.19.0-0 || ^3.19.1-0 || ^3.19.2-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  }
